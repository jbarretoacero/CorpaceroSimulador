<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CorpaceroSimulador" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/corp_blue</item>
        <item name="android:navigationBarColor">@color/corp_grey_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Splash con la API androidx.core:core-splashscreen -->
    <style name="Theme.CorpaceroSimulador.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_corpacero</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.CorpaceroSimulador</item>
    </style>

</resources>
